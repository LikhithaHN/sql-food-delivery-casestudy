-- =====================================================================
-- Problem 1: Active restaurant distribution by city and state
-- =====================================================================
-- Examine active restaurant distribution by city and state for
-- high-rated establishments (average_rating >= 3.5).
--
-- Expected output columns (in order):
--   city, state, restaurant_count, avg_rating
--
-- Schema: food-delivery (restaurants table)
-- Technique: GROUP BY + aggregate functions (COUNT, AVG)
-- =====================================================================

select
    city,
    state,
    count(restaurant_id)          as restaurant_count,
    round(avg(average_rating), 2) as avg_rating
from restaurants
where is_active = TRUE
    and average_rating >= 3.5
group by city, state
order by state asc, city asc;


-- =====================================================================
-- Problem 2: Menu item popularity by category and spice level
-- =====================================================================
-- Study menu item popularity by category and spice level across all
-- restaurants.
--
-- Expected output columns (in order):
--   category_name, spice_level, items_ordered, total_quantity
--
-- Schema: food-delivery (item_categories, menu_items, order_items)
-- Technique: Multi-table JOIN + COUNT(DISTINCT) to avoid fan-out
-- =====================================================================

select
    i.category_name,
    m.spice_level,
    count(distinct o.item_id) as items_ordered,
    sum(o.quantity)           as total_quantity
from item_categories i
join menu_items as m on i.item_category_id = m.item_category_id
join order_items as o on o.item_id = m.item_id
group by i.category_name, m.spice_level
order by i.category_name asc, total_quantity desc;


-- =====================================================================
-- Problem 3: Delivery performance by vehicle type and status
-- =====================================================================
-- Analyze delivery performance by vehicle type and delivery status
-- patterns.
--
-- Expected output columns (in order):
--   vehicle_type, delivery_status, total_deliveries, avg_distance
--
-- Schema: food-delivery (delivery_personnel, deliveries)
-- Technique: JOIN + GROUP BY
-- =====================================================================

select
    vehicle_type,
    delivery_status,
    count(delivery_id)                  as total_deliveries,
    round(avg(delivery_distance_km), 2) as avg_distance
from delivery_personnel dp
join deliveries d on d.delivery_person_id = dp.delivery_person_id
group by vehicle_type, delivery_status
order by vehicle_type asc, delivery_status asc;


-- =====================================================================
-- Problem 4: Promotion effectiveness by discount type and order month
-- =====================================================================
-- Analyze promotion effectiveness by discount type and order month.
--
-- Expected output columns (in order):
--   discount_type, order_month, orders_with_promotion, total_discount_given
--
-- Schema: food-delivery (promotions, orders)
-- Technique: JOIN + GROUP BY + EXTRACT() for date-part grouping
-- =====================================================================

select
    discount_type,
    extract(month from order_date)  as order_month,
    count(o.promotion_id)           as orders_with_promotion,
    round(sum(discount_amount), 2)  as total_discount_given
from promotions as p
join orders as o on o.promotion_id = p.promotion_id
group by discount_type, order_month
order by order_month asc, total_discount_given desc;
